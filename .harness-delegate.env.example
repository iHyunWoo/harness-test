# Harness Delegate 설치용 값. 실제 값은 .harness-delegate.env 에 두고 커밋하지 않는다.
# Harness UI: Project Settings > Delegates > New Delegate 에서 확인.
HARNESS_ACCOUNT_ID=your-account-id
HARNESS_DELEGATE_TOKEN=your-delegate-token
HARNESS_DELEGATE_NAME=helm-delegate
HARNESS_MANAGER_ENDPOINT=https://app.harness.io
HARNESS_DELEGATE_IMAGE=us-docker.pkg.dev/gar-prod-setup/harness-public/harness/delegate:26.08.89804
# 노드가 작을 때만 지정. 기본값은 cpu 1 / memory 2048.
HARNESS_DELEGATE_CPU=1
HARNESS_DELEGATE_MEMORY=2048
